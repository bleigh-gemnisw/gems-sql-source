MAS 23000
LIST X99999 KEY1
YR X9999 - LYR                       "LIST YEAR"
NAME A40
SNAME A32 - 2NDNAME
STREET A30 - ADDRESS
CITYST A30 - CITY
ZIP X99999
EZIP X9999
DISTRICT X9
BANK X999
FRZC A1
FRZY X99
* Field used to hold # of billing units for sewer use/frozen tax amounts for RE
FRZT D2 - TAXFROZ #EDU
CB D2
EXEMP D
GROSS D
AGROSS D
DESC A32 - LOC DESCRIP
1DESC A30
2DESC A30
VOL A9
MAP A18
MAKE A6
MARKER A8
IDENT# A20
CLASS X99
VYR X9999           "MOTOR VEHICLE YEAR"
AMT1 D2        "1ST HALF TAXES DUE"
AMT2 D2
INT1 D2
INT2 D2
ADJ1 D2
ADJ2 D2
LIEN D2
PDLIEN D2
PMT1 D2
PMT2 D2
FEES D2
INTD1 D2
INTD2 D2
CERT# I
LPAY DT         "DATE OF LAST PAYMENT - USED TO CALCULATED INTEREST DUE"
LADJ DT         "DATE OF LAST ADJUSTMENT - USED TO CALCULATED INTEREST DUE"
DOB DT
SDOB DT
DEL A1          "Y IF MATCH IN DELINQUENT FILE"
RFLAG A1        "Y IF NOTICE RETURNED"
SUSF A1         "SUSPENSE FLAG"
SUSDA DT        "SUSPENSE DATE"
*
NAC XA99999
ACCT X9999999
TYPE A2
WARRANT A1
COMMENT A60
notes1 a72
notes2 a72
notes3 a72
notes4 a72
*
custid x9999999999
scustid x9999999999
vehicleid x999999999
lease a1
*
CHG A1       "X if value modified by Assessor"
RM A1		"returned mail"
*
BDATE DT
EDU D2
SHED A2
RATE D2
